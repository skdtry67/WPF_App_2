<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WPF飲料訂購ver1" Height="471" Width="832">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="309"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Background="#FFF9F5F5">
            <StackPanel Height="36" Margin="5" Background="#FFD5EDED" Orientation="Horizontal">
                <Label Content="紅茶大杯" FontSize="14" VerticalContentAlignment="Center" Margin="20,0,0,0" FontWeight="Bold" Foreground="Brown"/>
                <Label Content="60元" FontSize="14" VerticalContentAlignment="Center" Margin="20,0,0,0" FontWeight="Bold" Foreground="DarkGreen"/>
                <TextBox x:Name="TxtRedTeaL" FontSize="14" VerticalContentAlignment="Center" Margin="100,0,0,0" Height="26" Width="100" HorizontalContentAlignment="Right" TextChanged="TextBox_TextChanged" />
            </StackPanel>

            <StackPanel Height="36" Margin="5" Background="#FFD5EDED" Orientation="Horizontal">
                <Label Content="紅茶小杯" FontSize="14" VerticalContentAlignment="Center" Margin="20,0,0,0" FontWeight="Bold" Foreground="Brown"/>
                <Label Content="40元" FontSize="14" VerticalContentAlignment="Center" Margin="20,0,0,0" FontWeight="Bold" Foreground="DarkGreen"/>
                <TextBox x:Name="TxtRedTeaS" FontSize="14" VerticalContentAlignment="Center" Margin="100,0,0,0" Height="26" Width="100" HorizontalContentAlignment="Right" TextChanged="TextBox_TextChanged" />
            </StackPanel>

            <StackPanel Height="36" Margin="5" Background="#FFD5EDED" Orientation="Horizontal">
                <Label Content="綠茶大杯" FontSize="14" VerticalContentAlignment="Center" Margin="20,0,0,0" FontWeight="Bold" Foreground="Brown"/>
                <Label Content="60元" FontSize="14" VerticalContentAlignment="Center" Margin="20,0,0,0" FontWeight="Bold" Foreground="DarkGreen"/>
                <TextBox x:Name="TxtGreenTeaL" FontSize="14" VerticalContentAlignment="Center" Margin="100,0,0,0" Height="26" Width="100" HorizontalContentAlignment="Right" TextChanged="TextBox_TextChanged" />
            </StackPanel>

            <StackPanel Height="36" Margin="5" Background="#FFD5EDED" Orientation="Horizontal">
                <Label Content="綠茶小杯" FontSize="14" VerticalContentAlignment="Center" Margin="20,0,0,0" FontWeight="Bold" Foreground="Brown"/>
                <Label Content="40元" FontSize="14" VerticalContentAlignment="Center" Margin="20,0,0,0" FontWeight="Bold" Foreground="DarkGreen"/>
                <TextBox x:Name="TxtGreenTeaS" FontSize="14" VerticalContentAlignment="Center" Margin="100,0,0,0" Height="26" Width="100" HorizontalContentAlignment="Right" TextChanged="TextBox_TextChanged" />
            </StackPanel>

            <StackPanel Height="36" Margin="5" Background="#FFD5EDED" Orientation="Horizontal">
                <Label Content="可樂大杯" FontSize="14" VerticalContentAlignment="Center" Margin="20,0,0,0" FontWeight="Bold" Foreground="Brown"/>
                <Label Content="50元" FontSize="14" VerticalContentAlignment="Center" Margin="20,0,0,0" FontWeight="Bold" Foreground="DarkGreen"/>
                <TextBox x:Name="TxtCokeL" FontSize="14" VerticalContentAlignment="Center" Margin="100,0,0,0" Height="26" Width="100" HorizontalContentAlignment="Right" TextChanged="TextBox_TextChanged" />
            </StackPanel>

            <StackPanel Height="36" Margin="5" Background="#FFD5EDED" Orientation="Horizontal">
                <Label Content="可樂小杯" FontSize="14" VerticalContentAlignment="Center" Margin="20,0,0,0" FontWeight="Bold" Foreground="Brown"/>
                <Label Content="30元" FontSize="14" VerticalContentAlignment="Center" Margin="20,0,0,0" FontWeight="Bold" Foreground="DarkGreen"/>
                <TextBox x:Name="TxtCokeS" FontSize="14" VerticalContentAlignment="Center" Margin="100,0,0,0" Height="26" Width="100" HorizontalContentAlignment="Right" TextChanged="TextBox_TextChanged" />
            </StackPanel>
        </StackPanel>

        <Button x:Name="OrderButton" Grid.Column="1" Content="訂購" HorizontalAlignment="Left" Margin="50,100,0,0" VerticalAlignment="Top" Height="60" Width="120" FontSize="16" Click="OrderButton_Click"/>

        <!-- 顯示訂購結果區 -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="10" Background="#FFF9FBE3" CornerRadius="5" Padding="10">
            <TextBlock x:Name="ResultTextBlock" FontSize="16" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>